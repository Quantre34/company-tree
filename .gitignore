# Build outputs (regenerated by `cd _source && npm run build`)
/assets/
/fonts/
/index.html

# Deployment-specific: keep out of public repo. Each installer supplies
# their own logo & (optional) backfilled seed.
/logo.png
/_source/src/data/seed.local.json

# Local API data dir (api/tree.php's .data/ fallback, and any api/ dir
# php -S test server creates for local testing) — never real, never ship.
/.data/
/api/.data/

# Node
_source/node_modules/
_source/dist/
_source/*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
*.log

# Local screenshots / references
Screenshot*.png

# PWA icons — build outputs (source in _source/public/)
/apple-touch-icon.png
/icon-*.png
/icon.svg
/manifest.webmanifest
/_deploy_public_html/
